{% extends 'default.html.twig' %}

{% block stylesheets %}

	{{ parent() }}

	{% if page.header.banner.background is defined and page.media[page.header.banner.background] %}
		{% set background_url = page.media[page.header.banner.background].url %}
	{% else %}
		{% set background_url = url('theme://images/banner.jpg') %}
	{% endif %}
	{% style %}
	#banner {
		background-image: url("{{ url('theme://css/images/overlay.png') }}"), url("{{ url('theme://css/images/overlay.png') }}"), url("{{ background_url }}");
	}
	{% endstyle %}

{% endblock %}

{% block body %}
	{{ include('partials/banner.html.twig') }}

	<!-- Main -->
		<section id="main">
			<div class="container">
				<div class="row gtr-200">

				{{ include('partials/highlights.html.twig') }}

				{% block features %}
					{{ include('partials/page-features.html.twig') }}
				{% endblock %}

				{% block major_news %}
					{{ include('partials/blog-preview.html.twig') }}
				{% endblock %}

				</div>
			</div>
		</section>

{% endblock %}
