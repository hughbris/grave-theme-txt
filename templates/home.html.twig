{% extends 'default.html.twig' %}

{% block stylesheets %}

	{{ parent() }}

	{# TODO: allow setting these background paths in theme.yaml #}
	{% style %}
	#banner {
		background-image: url("{{ url('theme://css/images/overlay.png') }}"), url("{{ url('theme://css/images/overlay.png') }}"), url("{{ url('theme://images/banner.jpg') }}");
	} 
	{% endstyle %}

{% endblock %}

{% block body %}
	{{ include('partials/banner.html.twig') }}

	<!-- Main -->
		<section id="main">
			<div class="container">
				<div class="row gtr-200">

				{{ include('partials/highlights.html.twig') }}

				{% block features %}
					{{ include('partials/page-features.html.twig') }}
				{% endblock %}

				{% block major_news %}
					{{ include('partials/blog-preview.html.twig') }}
				{% endblock %}

				</div>
			</div>
		</section>

{% endblock %}
