{% macro loop(page) %}
	{% for p in page.children.visible %}
		{% set current_page_class = (p.active or p.activeChild) ? ' class="current"' : '' %}
		{% if p.children.visible.count > 0 %}
			<li{{ current_page_class|raw }}>
				<a href="{{ p.url }}">
					{% if p.header.icon %}{% set nav_icons_used = true %}<i class="fa{{ not(fa_conformance) ? ' far' }} fa-{{ p.header.icon }}"></i>{% endif %}
					{{ p.menu }}
				</a>
				<ul>
					{{ _self.loop(p) }}
				</ul>
			</li>
		{% else %}
			<li{{ current_page_class|raw }}>
				<a href="{{ p.url }}">
					{% if p.header.icon %}{% set nav_icons_used = true %}<i class="fa{{ not(fa_conformance) ? ' far' }} fa-{{ p.header.icon }}"></i>{% endif %}
					{{ p.menu }}
				</a>
			</li>
		{% endif %}
	{% endfor %}
{% endmacro %}

{% set nav_icons_used = false %}
<ul>
	{% if config.theme.dropdown.enabled %}
		{{ _self.loop(pages) }}
	{% else %}
		{% for page in pages.children.visible %}
			<li{% if page.active or page.activeChild %} class="current"{% endif %}>
				<a href="{{ page.url }}">
					{% if page.header.icon %}{% set nav_icons_used = true %}<i class="fa{{ not(fa_conformance) ? ' far' }} fa-{{ page.header.icon }}"></i>{% endif %} {# TODO: check this, probably not needed anyway #}
					{{ page.menu }}
				</a>
			</li>
		{% endfor %}
	{% endif %}
	{% for mitem in site.menu %}
		<li>
			<a href="{{ mitem.url }}">
				{% if mitem.icon %}{% set nav_icons_used = true %}<i class="fa{{ not(fa_conformance) ? ' far' }} fa-{{ mitem.icon }}"></i>{% endif %}
				{{ mitem.text }}
			</a>
		</li>
	{% endfor %}
</ul>

{% if nav_icons_used %}
	{% include 'partials/check-fa.twig' %}
{% endif %}
