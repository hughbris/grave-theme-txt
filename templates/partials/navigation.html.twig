{% macro loop(page) %}
	{% for p in page.children.visible %}
		{% set current_page_class = (p.active or p.activeChild) ? ' class="current"' : '' %}
		{% if p.children.visible.count > 0 %}
			<li{{ current_page_class|raw }}>
				<a href="{{ p.url }}">
					{{ _self.addIcon(p.header) }}
					{{ p.menu }}
				</a>
				<ul>
					{{ _self.loop(p) }}
				</ul>
			</li>
		{% else %}
			<li{{ current_page_class|raw }}>
				<a href="{{ p.url }}">
					{{ _self.addIcon(p.header) }}
					{{ p.menu }}
				</a>
			</li>
		{% endif %}
	{% endfor %}
{% endmacro %}

{% macro addIcon(nav_item) %}
	{% spaceless %}
		{% if nav_item.icon %}
			{% set nav_icons_used = true %}
			{{ include('partials/navigation-icon.html.twig', {nav_item: nav_item} ) }}
		{% endif %}
	{% endspaceless %}
{% endmacro %}

{% set nav_icons_used = false %}
<ul>
	{% if config.theme.dropdown.enabled %}
		{{ _self.loop(pages) }}
	{% else %}
		{% for page in pages.children.visible %}
			<li{% if page.active or page.activeChild %} class="current"{% endif %}>
				<a href="{{ page.url }}">
					{{ _self.addIcon(page.header) }}
					{{ page.menu }}
				</a>
			</li>
		{% endfor %}
	{% endif %}
	{% for mitem in site.menu %}
		<li>
			<a href="{{ mitem.url }}">
				{{ _self.addIcon(mitem) }}
				{{ mitem.text }}
			</a>
		</li>
	{% endfor %}
</ul>

{% if nav_icons_used %}
	{% include 'partials/check-fa.twig' %}
{% endif %}
