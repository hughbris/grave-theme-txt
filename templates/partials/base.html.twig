<html lang="{{ grav.language.getActive ?: grav.config.site.default_lang }}">
<head>
{% block head %}
	<title>{% if header.title %}{{ header.title|e('html') }} - {% endif %}{{ site.title|e('html') }}</title>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />

	{{ include('partials/metadata.html.twig') }}

	<link rel="icon" type="image/png" href="{{ url('theme://images/logo.png') }}" /> {# TODO: allow setting in theme.yaml #}
	<link rel="canonical" href="{{ page.url(true, true) }}" />
{% endblock head %}

{% block stylesheets %}
	{% block fa_stylesheet %}
		{% set fa_conformance = config.theme.conformance.fontawesome ?? true %}
		{% if fa_conformance %}
			{% style 'theme://css/fontawesome-all.min.css' priority: 99 %}
		{% endif %}
	{% endblock fa_stylesheet %}
	{% style 'theme://css/main.css' priority: 98 %}
	{% style 'theme://css/main-extensions.css' priority: 97 %}
	{% style 'theme://css/custom.css' priority: 96 %}
{% endblock %}

{% block javascripts %}
	{% script 'theme://js/jquery.min.js'  at 'bottom' %}
	{% script 'theme://js/jquery.dropotron.min.js'  at 'bottom' %}
	{% script 'theme://js/jquery.scrolly.min.js'  at 'bottom' %}
	{% script 'theme://js/browser.min.js'  at 'bottom' %}
	{% script 'theme://js/breakpoints.min.js'  at 'bottom' %}
	{% script 'theme://js/util.js'  at 'bottom' %}
	{% script 'theme://js/main.js'  at 'bottom' %}
{% endblock %}

{% block assets deferred %}
	{{ assets.css()|raw }}
	{{ assets.js()|raw }}
{% endblock %}
</head>

<body id="top" class="{{ ['is-preload', "template-#{page.template}", page.header.body_classes]|join(' ')|trim }}">
	<div id="page-wrapper">

{% block header %}

	<!-- Header -->
		<header id="header">
			{% block logo_container %}
			<div class="logo container">
				<div>
					<h1><a href="{{ home_url }}" id="logo">{{ config.theme.heading|default(site.title) }}</a></h1>
					{%- if config.theme.subheading|default(false) %}
						<p>{{ config.theme.subheading }}</p>
					{% endif -%}
				</div>
			</div>
			{% endblock %}
		</header>

	{% block header_navigation %}
	<!-- Nav -->
		<nav id="nav">
			{{ include('partials/navigation.html.twig') }}
		</nav>
	{% endblock %}

{% endblock %}

{% block body %}
	<!-- Main -->
		<section id="main">
			<div class="container">
				<div class="row">
					{% block content %}{% endblock %}
					{% block features %}{% endblock %}
				</div>
			</div>
		</section>
{% endblock %}

{% block footer %}
	<!-- Footer -->
		<footer id="footer">
			<div class="container">
				{{ include('partials/footer.html.twig') }}
			</div>
		</footer>
{% endblock %}

	</div> {# // page-wrapper #}

{% block bottom %}
	{{ assets.js('bottom')|raw }}
{% endblock %}

</body>
</html>
